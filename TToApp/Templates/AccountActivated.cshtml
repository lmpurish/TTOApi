<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activate Your Account</title>
</head>

<body style="margin:0;padding:0;background:#f4f6f9;font-family:Arial,sans-serif;">

    <div style="max-width:600px;margin:40px auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">

        <!-- HEADER -->
        <div style="background:#0a4d8c;padding:30px;text-align:center;">
            <h1 style="color:white;margin:0;font-size:28px;">
                Welcome to TTO Logistics
            </h1>

            <p style="color:#dbeafe;margin-top:10px;font-size:16px;">
                Your account has been activated successfully
            </p>
        </div>

        <!-- BODY -->
        <div style="padding:35px;">

            <p style="font-size:16px;color:#374151;">
                Hello <strong>{{Name}} {{LastName}}</strong>,
            </p>

            <p style="font-size:16px;color:#374151;line-height:1.7;">
                We are excited to inform you that your driver account with
                <strong>Torres Transportation One LLC (TTO Logistics)</strong>
                is now active.
            </p>

            <p style="font-size:16px;color:#374151;line-height:1.7;">
                To access your portal and complete your onboarding process,
                please create your password using the secure button below.
            </p>

            <!-- BUTTON -->
            <div style="text-align:center;margin:40px 0;">

                <a href="{{ResetLink}}"
                   target="_blank"
                   style="
                        background:#0a4d8c;
                        color:white;
                        text-decoration:none;
                        padding:16px 30px;
                        border-radius:8px;
                        display:inline-block;
                        font-size:16px;
                        font-weight:bold;
                   ">

                    Create My Password

                </a>

            </div>

            <!-- FALLBACK -->
            <p style="font-size:14px;color:#6b7280;line-height:1.6;">
                If the button above does not work, copy and paste this link into your browser:
            </p>

            <div style="
                background:#f3f4f6;
                border:1px solid #d1d5db;
                padding:14px;
                border-radius:8px;
                font-size:13px;
                word-break:break-all;
                color:#111827;
            ">
                {{ResetLink}}
            </div>

            <!-- SECURITY -->
            <div style="
                margin-top:30px;
                background:#fff7ed;
                border:1px solid #fdba74;
                padding:16px;
                border-radius:8px;
            ">

                <p style="margin:0;color:#9a3412;font-size:14px;line-height:1.6;">
                    🔒 This activation link will expire in 24 hours for security reasons.
                </p>

            </div>

            <!-- LOGIN INFO -->
            <div style="margin-top:35px;">

                <h3 style="color:#111827;margin-bottom:15px;">
                    Driver Portal
                </h3>

                <p style="font-size:15px;color:#374151;margin:5px 0;">
                    <strong>Email:</strong> {{Email}}
                </p>

                <p style="font-size:15px;color:#374151;margin:5px 0;">
                    <strong>Portal:</strong>
                    <a href="https://admin.ttologistics.com"
                       target="_blank"
                       style="color:#0a4d8c;text-decoration:none;">
                        admin.ttologistics.com
                    </a>
                </p>

            </div>

            <!-- FOOTER -->
            <div style="margin-top:45px;border-top:1px solid #e5e7eb;padding-top:25px;">

                <p style="font-size:15px;color:#374151;">
                    Best regards,
                </p>

                <p style="font-size:16px;font-weight:bold;color:#111827;">
                    TTO Logistics Team
                </p>

            </div>

        </div>

    </div>

</body>
</html>